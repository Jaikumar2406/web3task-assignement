# Local development defaults. Never commit real credentials.
DATABASE_URL=postgresql+psycopg2://webhook:webhook@postgres:5432/webhooks
REDIS_URL=redis://redis:6379/0

HTTP_TIMEOUT_SECONDS=10
MAX_RETRIES=3
BACKOFF_BASE_SECONDS=2

RATE_LIMIT_CAPACITY=5
RATE_LIMIT_REFILL_PER_SECOND=1
EXTRA_RETRYABLE_STATUS_CODES=

ALLOW_PRIVATE_DESTINATIONS=true
MAX_PAYLOAD_BYTES=262144

SWEEPER_INTERVAL_SECONDS=30
STALE_JOB_THRESHOLD_SECONDS=120
LOG_LEVEL=INFO
